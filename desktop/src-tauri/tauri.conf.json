{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bnm-desktop",
  "mainBinaryName": "bnm-desktop",
  "version": "0.1.0",
  "identifier": "io.github.dopecape.bnm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "bnm",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Wi-Fi, VPNs and network quality in one place",
    "longDescription": "bnm desktop: a NetworkManager front end. Wi-Fi, VPNs (Tailscale, WireGuard, OpenVPN), connection quality monitoring and speed tests, talking to the bnmd user daemon.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "depends": [
          "network-manager"
        ],
        "recommends": [
          "libnotify4"
        ],
        "section": "net",
        "desktopTemplate": "bnm-desktop.desktop.hbs"
      },
      "rpm": {
        "depends": [
          "NetworkManager"
        ],
        "recommends": [
          "libnotify"
        ],
        "desktopTemplate": "bnm-desktop.desktop.hbs"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
